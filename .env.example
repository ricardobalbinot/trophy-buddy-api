# PostgreSQL only. Standard provider URLs and postgresql+psycopg URLs are accepted.
DATABASE_URL=
# Used only by the optional local Docker Compose database.
POSTGRES_PASSWORD=

# Firebase Authentication: project ID and either certificate fields or a private JSON path.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
CORS_ORIGINS=

# Dedicated PSN service identity. End users never provide these values.
PSN_SERVICE_NPSSO=
# Base64-encoded 32-byte AES-256-GCM key. Keep stable across API replicas.
PSN_TOKEN_ENCRYPTION_KEY=

# Twitch application credentials for IGDB; server only.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Dedicated integration-test database; its name must end in _test.
TEST_DATABASE_URL=
